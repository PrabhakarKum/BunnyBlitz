                <ui:VisualElement name="line" style="background-image: url(&quot;project://database/Assets/BunnyBlitz/Game/UI/Textures/LineBlue.png?fileID=-249490896287310676&amp;guid=ee97764f1bcac4286a842a527398db49&amp;type=3#LineBlue_0&quot;); width: 133px; height: 84px; -unity-background-scale-mode: scale-to-fit; position: absolute; top: 34px; -unity-background-image-tint-color: rgb(141, 213, 255);"/>
