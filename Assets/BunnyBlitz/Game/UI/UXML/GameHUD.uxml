                <ui:VisualElement name="heart2" class="heart-visual heart-full" style="left: 13px; top: 19px; scale: 0.85 0.85;"/>
                <ui:VisualElement name="heart3" class="heart-visual heart-empty" style="top: 4px; left: 51px;"/>
                <ui:VisualElement name="line" style="background-image: url(&quot;project://database/Assets/BunnyBlitz/Game/UI/Textures/LineGreen.png?fileID=5541715196883081660&amp;guid=9557f80183523451fad862a48e4f10b1&amp;type=3#LineGreen_0&quot;); width: 148px; height: 90px; -unity-background-scale-mode: scale-to-fit; position: absolute; top: 28px;"/>
