                <ui:VisualElement name="line" style="background-image: url(&quot;project://database/Assets/BunnyBlitz/Game/UI/Textures/LineOrange.png?fileID=-6658224152391256740&amp;guid=f63ddadc3f905434a87f786ebe1b78dc&amp;type=3#LineOrange_0&quot;); width: 148px; height: 90px; -unity-background-scale-mode: scale-to-fit; position: absolute; top: 28px;"/>
