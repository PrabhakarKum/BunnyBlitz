                <ui:VisualElement name="line" style="background-image: url(&quot;project://database/Assets/BunnyBlitz/Game/UI/Textures/LineRed.png?fileID=1201460597218266340&amp;guid=ce4a71f76e1c04a92a134152f0c02e3a&amp;type=3#LineRed_0&quot;); width: 148px; height: 90px; -unity-background-scale-mode: scale-to-fit; position: absolute; top: 28px;"/>
